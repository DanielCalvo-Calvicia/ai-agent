# Names only: GitHub Actions reads these directly from repository settings.
# Configure them under Settings > Secrets and variables > Actions. This file holds
# no value (and never will): the values live in GitHub.
#
# The file has two parts, and each name belongs to exactly ONE of them:
#   PART 1  REPOSITORY VARIABLES  tab "Variables": plain settings, visible in the logs.
#   PART 2  REPOSITORY SECRETS    tab "Secrets": credentials and anything private,
#                                 masked in the logs, never shown again once saved.
# Rule of thumb: if a leak of the value would be a problem, it is a Secret.
#
# How the names of this file relate to the ones the process reads
# ---------------------------------------------------------------
# ~step-6-deploy.yml writes every setting that is set as a key of the Kubernetes Secret
# <PROJECTNAME>-secrets, which the pod reads with envFrom: the NAME here is exactly the name the
# code reads (.env.example, docs/configuration/environment-variables.md). One that is empty or
# unset is not written, so the default of the code applies.
#
# The workflow COMPUTES three keys and they always win:
#   PROJECTNAME  from the Variable of the same name (the Kubernetes service name)
#   APP_ENV      development | production; shared-logging puts it on every log line
#   HTTP_ADDR    ":" + 30000 (development) or 31000 (production) + PORT_OFFSET; the same
#                number is the containerPort, the Service port and the nodePort.
#                It is the name and the format dynamics_microservice reads too (ai-agent
#                used AI_AGENT_HOST and AI_AGENT_PORT before this pipeline).
# AI_AGENT_RELOAD is not computed: the Dockerfile sets it to 0 (the code default is 1,
# uvicorn auto-reload, for development only).

# ===========================================================================
# PART 1 - REPOSITORY VARIABLES  (Settings > Secrets and variables > Actions > Variables)
# ===========================================================================

# ---------------------------------------------------------------------------
# 1a. Variables of the workflows
# ---------------------------------------------------------------------------
# KILL SWITCH of the deploy. When it is the text false, the deploy flow does nothing:
# no image is built or pushed and nothing is applied to the cluster (both the push
# triggers and a manual run obey it; the run page says it was skipped). Unset, or any
# other value, deploys. The verify workflows (secrets, lint, tests) are not affected.
DEPLOY_ENABLED=
# Kubernetes service name and prefix of the application Secret (<PROJECTNAME>-secrets).
# E.g. ai-agent (lower case, digits and hyphens only).
PROJECTNAME=
# The only mandatory port-related Variable: ~step-6-deploy.yml adds it to 30000
# (development) or 31000 (production) and uses that one number for the container
# port, the Service port, targetPort, nodePort and HTTP_ADDR. Pick a number no other
# service of the cluster uses (dynamics_microservice has its own). E.g. PORT_OFFSET=3
# means port 30003 in development and 31003 in production.
PORT_OFFSET=
# Python version of the Docker image and of the test job. Optional: empty = 3.14, the
# version of the venv the pins of requirements.txt were taken from.
PYTHON_VERSION=

# ---------------------------------------------------------------------------
# 1b. Variables with the settings of the service
# They are the variables of .env.example (docs/configuration/environment-variables.md).
# None is required (each has the default of the code), except GOOGLE_URL when a Google
# model is used: the code has no default for it. Names only, never a value.
# ---------------------------------------------------------------------------

# OpenAI-compatible base URLs of the providers (public endpoints).
GOOGLE_URL=
MISTRAL_URL=
GROQ_URL=
COHERE_URL=

# Langfuse (only used when its keys, in PART 2, are set). Empty = https://cloud.langfuse.com (EU).
LANGFUSE_HOST=

# Behaviour of the service (defaults in .env.example)
AI_AGENT_RELOAD=
AI_AGENT_HISTORY_TURNS=
AI_AGENT_PARALLEL_ACTIONS=
AI_AGENT_MAX_ATTEMPTS=
AI_AGENT_RETRY_WAIT_SECONDS=
AI_AGENT_MAX_MCP_CALLS_PER_MESSAGE=
# 1 = hide personal columns of the tool answers before any model sees them (the default); 0 = send them.
AI_AGENT_MASK_PERSONAL_DATA=
AI_AGENT_MCP_CALL_TIMEOUT_SECONDS=
AI_AGENT_SPEECH_CHARS_PER_SECOND=
# A number makes the gestures repeatable (tests); empty = random.
AI_AGENT_EXPRESSION_SEED=
# 1 = check at start-up (log only) that dynamics_microservice answers.
AI_AGENT_CHECK_MCP_DYNAMICS_MICROSERVICE=

# Logging and tracing (read by shared-logging, docs/logging.md of that package; defaults: INFO, json, stdout)
LOG_LEVEL=
LOG_FORMAT=
LOG_OUTPUT=
SERVICE_NAME=
# Optional export of the spans to a trace storage service (off unless TRACE_EXPORT_ENABLED is true;
# its URL and headers are Secrets, in PART 2b).
TRACE_EXPORT_ENABLED=
TRACE_EXPORT_TIMEOUT=
TRACE_EXPORT_BATCH_SIZE=
TRACE_EXPORT_FLUSH_INTERVAL=
TRACE_EXPORT_QUEUE_SIZE=
TRACE_EXPORT_ATTRIBUTES=

# Folder mounted by mcps/filesystem.json (a stdio MCP server run with docker): it is read by the code, but
# a pod has no docker, so it has no use in the cluster today.
MCP_FILESYSTEM_DIR=

# ===========================================================================
# PART 2 - REPOSITORY SECRETS  (Settings > Secrets and variables > Actions > Secrets)
# ===========================================================================

# ---------------------------------------------------------------------------
# 2a. Secrets of the workflows
# ---------------------------------------------------------------------------
# Classic GitHub PAT with read:packages; grant it access to the GHCR package. It is
# the credential of the image pull secret of the cluster.
GH_PAT=
# Base64-encoded kubeconfig of the target cluster.
KUBE_CONFIG=
# Rancher project ids of the two namespaces (the annotation of k8s/namespace.yaml).
RANCHER_PROJECT_ID_DEVELOPMENT=
RANCHER_PROJECT_ID_PRODUCTION=

# ---------------------------------------------------------------------------
# 2b. Secrets with the settings of the service
# At least ONE provider key (or OLLAMA_URL) must be set or the deploy stops. The profiles
# shipped today use GOOGLE_API_KEY (proven, default) and ANTHROPIC_API_KEY (claude_haiku,
# claude_mixed, claude_sonnet); the others are read by the code and used by no profile yet.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
# Local Ollama endpoint (a private host).
OLLAMA_URL=
# Langfuse keys. WHAT IS SENT: the user's text and the prompts and answers of every call
# (docs/security/security.md). Leave both unset to send nothing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Trace export (shared-logging): the endpoint of the trace storage service (a private host) and
# extra request headers as Name=value,Name2=value2 (they may carry an API key).
TRACE_EXPORT_URL=
TRACE_EXPORT_HEADERS=

# ---------------------------------------------------------------------------
# 2c. Secrets with the URL of dynamics_microservice, one per environment
# The full Streamable HTTP URL with its /mcp path (the MCP_PATH of that service). The host
# is private, so they are Secrets. ~step-6-deploy.yml writes the one of the environment being
# deployed as DYNAMICS_MCP_URL (the name the code reads). Unset: that MCP server is skipped
# with a warning and the Dynamics tools cannot be called. Inside the cluster it can be the
# service name of the Go service:
#   http://<its PROJECTNAME>.<namespace>.svc.cluster.local:<its port>/mcp
# ---------------------------------------------------------------------------
DYNAMICS_MCP_URL_DEVELOPMENT=
DYNAMICS_MCP_URL_PRODUCTION=

{
    "intent": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "information_request",
            "task_execution",
            "content_generation",
            "decision_support",
            "clarification_request",
            "system_operation"
          ],
          "description": "Single dominant intent category that best represents the user's request"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional supporting intent categories that are present but not dominant"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Classifier confidence score that the intent assignment is correct (0 = low confidence, 1 = certain)"
        }
      }
    }
}
# Copy to .env and fill in. Never commit .env.
# Variables already set in the environment win over this file.

# --- Provider keys (only the providers you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=     # only for the Claude profiles (claude_haiku, claude_mixed, claude_sonnet; ADR-013)
GOOGLE_API_KEY=        # the default models are Google's; the free tier is enough to run and test (docs/security/security.md)
MISTRAL_API_KEY=       # no Mistral model can be chosen until its API id is verified (ADR-012)
GROQ_API_KEY=
COHERE_API_KEY=

# --- Cost tracking (optional): Langfuse shows every LLM call with model, tokens (thinking included) and cost ---
# Create a free project at https://cloud.langfuse.com and copy its API keys. WHAT IS SENT: model, tokens and cost of every call,
# AND the payload sent and the answer received (the user's text and the prompts). Use a project you trust with them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=             # empty = https://cloud.langfuse.com (EU). US: https://us.cloud.langfuse.com

# --- OpenAI-compatible base URLs ---
GOOGLE_URL=
MISTRAL_URL=
GROQ_URL=
COHERE_URL=
OLLAMA_URL=

# --- Service ---
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=7998
AI_AGENT_RELOAD=1          # 1 = auto-reload for development, 0 for a stable run
AI_AGENT_HISTORY_TURNS=6   # exchanges (user message + reply) remembered per session
AI_AGENT_PARALLEL_ACTIONS=1  # independent actions of a plan that may run at the same time (1 = one by one). 6 cut a 30-step plan from 58 s to 23 s on Google; keep 1 on Groq (8,000 tokens/minute)
AI_AGENT_MAX_ATTEMPTS=3    # tries (the first included) of a failed LLM call, MCP tool or `retry` answer
AI_AGENT_MAX_MCP_CALLS_PER_MESSAGE=5  # MCP tool actions one message may run; the rest are not run and the reply says so. 0 = no limit. Not a whole number or negative = 5
AI_AGENT_MCP_CALL_TIMEOUT_SECONDS=30  # seconds one MCP tool call may take (connect, initialize and call); keep it above the 20 s a slow query makes the server wait. Not a positive number = 30
# The arm gesture that goes with a spoken reply: after the conversation or special flow answers, the expression flow reads the
# emotion of the exchange (one more model call) and makes random movements that start with the speech and last about as long.
# 0 = no gestures. AI_AGENT_SPEECH_CHARS_PER_SECOND sizes the gesture from the reply's length. A number in AI_AGENT_EXPRESSION_SEED
# makes the gestures repeatable (tests).
AI_AGENT_EXPRESSION=1
AI_AGENT_SPEECH_CHARS_PER_SECOND=14
AI_AGENT_EXPRESSION_SEED=

# --- Which LLM each step uses: edit config/step_models.json (profiles, per-step choice). See docs/models/gemini_models_per_step.md ---
# AI_AGENT_MODELS_FILE=      # another config file instead of config/step_models.json
# --- Optional model overrides per phase (they win over the config file): any id of domain/value_objects/llm_request/model_catalog.py ---
# e.g. gemini-3.5-flash-lite (Google), llama-3.3-70b-versatile (Groq), claude-sonnet-5-5 (Anthropic).
# The provider needs its key and URL above.
# Phases: 1 triage, 2 project manager, 3 safety gate, 4 worker, 5 MCP operator,
#         6 data engineer, 7 draft writer, 8 editor in chief, 9 answer checker, 20 motion planner, 30 emotion reader, 99 clarification.
# Defaults: phases 1, 6, 9, 30 and 99 gemini-3.1-flash-lite, all others gemini-3.6-flash (the active profile proven of config/step_models.json overrides them: gemini-3.1-flash-lite on every step).
# AI_AGENT_MODEL_PHASE_1=
# AI_AGENT_MODEL_PHASE_2=

# --- MCP tool servers (mcps/*.json) ---
# Streamable HTTP endpoint of dynamics_microservice (read-only Business Central), the full URL with its /mcp path.
# Never commit a real host. Empty: the server is skipped with a warning and the other servers keep working.
DYNAMICS_MCP_URL=
# Optional reachability check, one variable per MCP server: AI_AGENT_CHECK_MCP_<NAME>=1 (<NAME> = the server name in upper case).
# It lists that server's tools at start-up and on every call of /available, and only logs a warning when it is not reachable.
# /available answers the same either way; with it set, that call does a network listing (up to 10 s). Unset or 0: no check.
# AI_AGENT_CHECK_MCP_DYNAMICS_MICROSERVICE=1

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ai-agent: debug (uvicorn, no reload)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/composition_root/main.py",
            "python": "${workspaceFolder}/windows/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "AI_AGENT_RELOAD": "0"
            }
        }
    ]
}
